{
  "name": "pl-creators-suite",
  "private": true,
  "version": "0.0.1",
  "description": "Offline-first creator-focused software suite.",
  "author": "Praecursor Labs",
  "desktopName": "pl-creators-suite",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "22.12.0",
    "pnpm": "10.31.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.28.6": "7.29.7",

      "brace-expansion@1": "1.1.17",
      "brace-expansion@2": "2.1.3",
      "brace-expansion@5": "5.0.8",

      "fast-uri@3": "3.1.5",
      "flatted@3": "3.4.2",
      "js-yaml@4": "4.3.0",

      "minimatch@3": "3.1.3",
      "minimatch@5": "5.1.7",
      "minimatch@9": "9.0.7",

      "picomatch@4": "4.0.4",
      "postcss": "8.5.23",
      "rollup": "4.59.0",
      "tar@7": "7.5.18",
      "undici@6": "6.28.0"
    }
  },
  "scripts": {
    "env:report": "node scripts/environment-report.js",
    "clean:build": "node scripts/clean-build.js",
    "test:smoke": "node scripts/smoke-test.js",
    "dev": "pnpm -r dev",
    "build:renderer": "pnpm --filter renderer build",
    "package:linux": "pnpm build:renderer && electron-builder --linux AppImage --config electron-builder.yml",
    "package:win": "pnpm build:renderer && electron-builder --win nsis --config electron-builder.yml",
    "clean:release": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "release:linux": "pnpm clean:release && pnpm package:linux",
    "release:win": "pnpm clean:release && pnpm package:win",
    "release:check": "ls -lah release && ls -lah release/linux-unpacked | head"
  },
  "devDependencies": {
    "electron": "41.10.3",
    "electron-builder": "26.15.6"
  }
}
